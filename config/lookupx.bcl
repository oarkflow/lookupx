  column "description" {
    kind "text"
    normalized true
  }
  column "fulltext" {
    kind "text"
    normalized true
  }
  column "header" {
    kind "keyword"
    normalized true
  }
  column "effective_date" {
    kind "keyword"
    normalized true
  }
}

datasource "dx_icd10_pcs" {
  kind "sql_query"
  driver "mysql"
  dsn env("MYSQL_DSN", "service:service@tcp(127.0.0.1:3306)/cleardb?parseTime=true&loc=UTC")
  id_column "record_id"
  query "SELECT id AS record_id, code_with_period AS code, REPLACE(LOWER(code_with_period), '.', '') AS code_no_period, med_desc AS description, COALESCE(long_desc, med_desc) AS `fulltext`, effective_date FROM vw_icd10_pcs"
  column "code" {
    kind "keyword"
    normalized true
  }
  column "code_no_period" {

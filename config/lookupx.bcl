bcl {
  version "1.0"
}

# Clear fulltext replacement index configuration.
# Set MYSQL_DSN to a MySQL DSN for a user that can SELECT the Clear lookup views
# and charge-master tables. The mysql driver is registered by cmd/lookupx.
addr env("ADDR", ":8089")
data_dir env("LOOKUPX_DATA_DIR", "./data/indexes")
api_keys [env("LOOKUPX_API_KEY", "")]

datasource "cpt" {
  kind "sql_query"
  driver "mysql"
  dsn env("MYSQL_DSN", "service:service@tcp(127.0.0.1:3306)/cleardb?parseTime=true&loc=UTC")
  id_column "record_id"
  query "SELECT CONCAT_WS(':', work_item, charge_type, effective_date, cpt_code, SHA2(JSON_ARRAY(work_item, charge_type, effective_date, cpt_code, end_effective_date, patient_status, ld), 256)) AS record_id, cpt_code AS code, REPLACE(LOWER(cpt_code), '.', '') AS code_no_period, ld AS description, ld AS `fulltext`, work_item AS work_item_uid, work_item, effective_date, end_effective_date, patient_status, charge_type FROM vw_cpt_master WHERE is_cpt = 1"
  column "code" {
    kind "keyword"
    normalized true
  }
  column "code_no_period" {
    kind "keyword"
    normalized true
  }
  column "description" {
    kind "text"
    normalized true
  }
  column "fulltext" {
    kind "text"
    normalized true
  }
  column "work_item" {
    kind "keyword"
    normalized true
  }
  column "work_item_uid" {
    kind "keyword"
    normalized true
  }
  column "effective_date" {
    kind "keyword"
    normalized true
  }
  column "end_effective_date" {
    kind "keyword"
    normalized true
  }
  column "patient_status" {
    kind "keyword"
    normalized true
  }
  column "charge_type" {
    kind "keyword"
    normalized true
  }
}

datasource "hcpcs" {
  kind "sql_query"
  driver "mysql"
  dsn env("MYSQL_DSN", "service:service@tcp(127.0.0.1:3306)/cleardb?parseTime=true&loc=UTC")
  id_column "record_id"
  query "SELECT CONCAT_WS(':', work_item, charge_type, effective_date, cpt_code, SHA2(JSON_ARRAY(work_item, charge_type, effective_date, cpt_code, end_effective_date, patient_status, ld), 256)) AS record_id, cpt_code AS code, REPLACE(LOWER(cpt_code), '.', '') AS code_no_period, ld AS description, ld AS `fulltext`, work_item AS work_item_uid, work_item, effective_date, end_effective_date, patient_status, charge_type FROM vw_cpt_master WHERE is_cpt = 0"
  column "code" {
    kind "keyword"
    normalized true
  }
  column "code_no_period" {
    kind "keyword"
    normalized true
  }
  column "description" {
    kind "text"
    normalized true
  }
  column "fulltext" {
    kind "text"
    normalized true
  }
  column "work_item" {
    kind "keyword"
    normalized true
  }
  column "work_item_uid" {
    kind "keyword"
    normalized true
  }
  column "effective_date" {
    kind "keyword"
    normalized true
  }
  column "end_effective_date" {
    kind "keyword"
    normalized true
  }
  column "patient_status" {
    kind "keyword"
    normalized true
  }
  column "charge_type" {
    kind "keyword"
    normalized true
  }
}

datasource "cpt_reference" {
  kind "sql_query"
  driver "mysql"
  dsn env("MYSQL_DSN", "service:service@tcp(127.0.0.1:3306)/cleardb?parseTime=true&loc=UTC")
  id_column "record_id"
  query "SELECT cpt_code AS record_id, cpt_code AS code, REPLACE(LOWER(cpt_code), '.', '') AS code_no_period, ld AS description, COALESCE(fd, ld) AS `fulltext` FROM vw_cpt WHERE cpt_code NOT REGEXP '^[A-Za-z][0-9]{4}$'"
  column "code" {
    kind "keyword"
    normalized true
  }
  column "code_no_period" {
    kind "keyword"
    normalized true
  }
  column "description" {
    kind "text"
    normalized true
  }
  column "fulltext" {
    kind "text"
    normalized true
  }
}

datasource "dx_fac1" {
  kind "sql_query"
  driver "mysql"
  dsn env("MYSQL_DSN", "service:service@tcp(127.0.0.1:3306)/cleardb?parseTime=true&loc=UTC")
  id_column "record_id"
  query "SELECT ICD9_CODE AS record_id, ICD9_CODE AS code, REPLACE(LOWER(ICD9_CODE), '.', '') AS code_no_period, LONG_DESCRIPTION AS description, COALESCE(FULL_DESCRIPTION, LONG_DESCRIPTION) AS `fulltext` FROM vw_icd9_fac_1"
  column "code" {
    kind "keyword"
    normalized true
  }
  column "code_no_period" {
    kind "keyword"
    normalized true
  }
  column "description" {
    kind "text"
    normalized true
  }
  column "fulltext" {
    kind "text"
    normalized true
  }
}


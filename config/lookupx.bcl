datasource "dx_icd10" {
  kind "sql_query"
  driver "mysql"
  dsn env("MYSQL_DSN", "service:service@tcp(127.0.0.1:3306)/cleardb?parseTime=true&loc=UTC")
  id_column "record_id"
  query "SELECT id AS record_id, code_with_period AS code, REPLACE(LOWER(code_with_period), '.', '') AS code_no_period, med_desc AS description, COALESCE(long_desc, med_desc) AS `fulltext`, header, effective_date FROM vw_icd10_cm"
  column "code" {
    kind "keyword"
    normalized true
  }
  column "code_no_period" {
    kind "keyword"
    normalized true

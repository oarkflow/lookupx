    kind "keyword"
    normalized true
  }
}

datasource "special_fac" {
  kind "sql_query"
  driver "mysql"
  dsn env("MYSQL_DSN", "service:service@tcp(127.0.0.1:3306)/cleardb?parseTime=true&loc=UTC")
  id_column "record_id"
  query "SELECT CONCAT_WS(':', cm.work_item_uid, cm.charge_type, cm.effective_date, cm.cpt_hcpcs_code) AS record_id, cm.cpt_hcpcs_code AS code, REPLACE(LOWER(cm.cpt_hcpcs_code), '.', '') AS code_no_period, cm.client_proc_desc AS description, cm.client_proc_desc AS `fulltext`, cm.work_item_uid AS work_item_uid, cm.work_item_uid AS work_item, cm.effective_date, cm.charge_type FROM tbl_charge_master cm JOIN (SELECT work_item_uid, charge_type, effective_date FROM tbl_charge_master WHERE charge_type = 'ED_FACILITY' GROUP BY work_item_uid, charge_type) latest USING (work_item_uid, charge_type, effective_date) LEFT JOIN lu_cpt ON lu_cpt.cpt_code = LEFT(cm.cpt_hcpcs_code, 5) LEFT JOIN tbl_work_item_em_level em ON em.work_item_uid = cm.work_item_uid AND em.charge_type = cm.charge_type AND em.code = cm.cpt_hcpcs_code WHERE lu_cpt.cpt_code IS NULL AND em.code IS NULL AND cm.client_internal_code <> ''"
  column "code" {
    kind "keyword"
    normalized true
  }
  column "code_no_period" {
    kind "keyword"
    normalized true
  }
  column "description" {
    kind "text"
    normalized true
  }
  column "fulltext" {
    kind "text"
    normalized true
  }
  column "work_item" {
    kind "keyword"
    normalized true
  }
  column "work_item_uid" {
    kind "keyword"
    normalized true
  }
  column "effective_date" {
    kind "keyword"
    normalized true
  }
  column "charge_type" {
    kind "keyword"
    normalized true
  }
}

datasource "special_pro" {
  kind "sql_query"
  driver "mysql"
  dsn env("MYSQL_DSN", "service:service@tcp(127.0.0.1:3306)/cleardb?parseTime=true&loc=UTC")
  id_column "record_id"
  query "SELECT CONCAT_WS(':', cm.work_item_uid, cm.charge_type, cm.effective_date, cm.cpt_hcpcs_code) AS record_id, cm.cpt_hcpcs_code AS code, REPLACE(LOWER(cm.cpt_hcpcs_code), '.', '') AS code_no_period, cm.client_proc_desc AS description, cm.client_proc_desc AS `fulltext`, cm.work_item_uid AS work_item_uid, cm.work_item_uid AS work_item, cm.effective_date, cm.charge_type FROM tbl_charge_master cm JOIN (SELECT work_item_uid, charge_type, effective_date FROM tbl_charge_master WHERE charge_type = 'ED_PROFEE' GROUP BY work_item_uid, charge_type) latest USING (work_item_uid, charge_type, effective_date) LEFT JOIN lu_cpt ON lu_cpt.cpt_code = LEFT(cm.cpt_hcpcs_code, 5) LEFT JOIN tbl_work_item_em_level em ON em.work_item_uid = cm.work_item_uid AND em.charge_type = cm.charge_type AND em.code = cm.cpt_hcpcs_code WHERE lu_cpt.cpt_code IS NULL AND em.code IS NULL AND cm.client_internal_code <> ''"
  column "code" {
    kind "keyword"
    normalized true
  }
  column "code_no_period" {
    kind "keyword"
    normalized true
  }
  column "description" {
    kind "text"
    normalized true
  }
  column "fulltext" {
    kind "text"
    normalized true
  }
  column "work_item" {
    kind "keyword"
    normalized true
  }
  column "work_item_uid" {
    kind "keyword"
    normalized true
  }
  column "effective_date" {
    kind "keyword"
    normalized true
  }
  column "charge_type" {
    kind "keyword"
    normalized true
  }
}

index "cpt" {
  schema "record"
  datasource "cpt"
  initial_capacity 1000000
  schema_field "code" {
    kind "keyword"
    indexed true
    stored true
    lookup true
    lowercase true
    prefix true
    term_search true
  }
  schema_field "code_no_period" {
    kind "keyword"
    indexed true
    stored true
    lowercase true
    prefix true
    term_search true
  }
  schema_field "description" {
    kind "text"
    indexed true
    stored true
    index_alias "fulltext"
    lowercase true
    term_search true
  }
  schema_field "fulltext" {
    kind "text"
    indexed true
    stored true
    lowercase true
    term_search true
  }
  schema_field "work_item" {
    kind "keyword"
    indexed false
    stored true
    stored_only true
    stored_alias "work_item_uid"
  }
  schema_field "work_item_uid" {
    kind "keyword"
    indexed true
    stored true
    lookup true
  }
  schema_field "effective_date" {
    kind "keyword"
    indexed true
    stored true
    lookup true
  }
  schema_field "end_effective_date" {
    kind "keyword"
    indexed true
    stored true
    lookup true
  }
  schema_field "patient_status" {
    kind "keyword"
    indexed true
    stored true
    lookup true
  }
  schema_field "charge_type" {
    kind "keyword"
    indexed true
    stored true
    lookup true
  }
  bulk {
    batch_size 32768
    checkpoint_every 10000
    checkpoint_path "./data/checkpoints/cpt.json"
    resume false
  }
}


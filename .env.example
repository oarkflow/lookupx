# Copy to .env and tune the heap ceiling for the host's available RAM.
ADDR=0.0.0.0:8089
FH_SECURE_BY_DEFAULT=true
# Replace lookupx.test with the public hostname or IP clients use.
FH_ALLOWED_HOSTS=localhost,127.0.0.1,lookupx.test
FH_MAX_HEAP_BYTES=4GiB
FH_MAX_IN_FLIGHT_REQUESTS=5000
FH_MAX_GOROUTINES=20000
FH_MAX_CONNECTIONS=10000
FH_MAX_CONNECTIONS_PER_IP=100
FH_MAX_BUFFERED_REQUEST_BYTES=67108864
FH_MAX_BUFFERED_RESPONSE_BYTES=67108864
FH_RESOURCE_CHECK_INTERVAL=250ms
FH_HSTS_PRELOAD=false

# Leave both admin values empty to create the first admin account in the browser.
# If both are set, they bootstrap the admin account once; later changes do not
# replace the credential stored in the private auth store.
LOOKUPX_ADMIN_USERNAME=
LOOKUPX_ADMIN_PASSWORD=
# Required for secure admin sessions; generate with: openssl rand -hex 32
LOOKUPX_SESSION_SECRET=
LOOKUPX_SESSION_SECURE=true
# Remote admin sessions and API keys require HTTPS through a trusted proxy.
# List its peer addresses/CIDRs; it must overwrite X-Forwarded-Proto.
LOOKUPX_SESSION_TRUSTED_PROXIES=

# Machine clients use X-API-Key or Authorization: Bearer. Keep this secret
# different from the admin password.
LOOKUPX_API_KEY=
